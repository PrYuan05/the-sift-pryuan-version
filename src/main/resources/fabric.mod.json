{
	"schemaVersion": 1,
	"id": "pysift",
	"version": "${version}",
	"name": "The Sift PrYuan's Version",
	"description": "A new dimension of layered strata, soul willows and glowing spirit liquid, guarded by three bosses. Open the way from an Ancient City, explore four biomes and fight 26 new creatures.",
	"authors": [
		"PrYuan05"
	],
	"contact": {
		"homepage": "https://github.com/PrYuan05/the-sift-pryuan-version",
		"sources": "https://github.com/PrYuan05/the-sift-pryuan-version",
		"issues": "https://github.com/PrYuan05/the-sift-pryuan-version/issues"
	},
	"license": "MIT",
	"icon": "assets/pysift/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"pryuan05.pysift.PySift"
		],
		"client": [
			"pryuan05.pysift.PySiftClient"
		]
	},
	"mixins": [
		"pysift.mixins.json",
		{
			"config": "pysift.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"geckolib": ">=5.5.7"
	}
}
